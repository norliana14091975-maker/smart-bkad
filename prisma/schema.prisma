generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Ringkasan APBD per tahun (grid 2x2 pada halaman APBD)
model ApbdSummary {
  year             Int   @id
  pendapatanApbd   Float @map("pendapatan_apbd")
  pendapatanApbdp  Float @map("pendapatan_apbdp")
  belanjaApbd      Float @map("belanja_apbd")
  belanjaApbdp     Float @map("belanja_apbdp")
  terimaApbd       Float @map("terima_apbd")
  terimaApbdp      Float @map("terima_apbdp")
  keluarApbd       Float @map("keluar_apbd")
  keluarApbdp      Float @map("keluar_apbdp")

  @@map("apbd_summary")
}

// Item anggaran: section (pendapatan|belanja|pembiayaan), tab, kode akun, tahun
model BudgetItem {
  id      Int    @id @default(autoincrement())
  section String
  tab     String
  code    String
  name    String
  year    Int
  amount  Float

  @@unique([section, tab, code, year])
  @@map("budget_item")
}

// Realisasi anggaran per akun per periode (bulan ke-1..12 dalam tahun anggaran).
// level 1-6 mengikuti struktur kode rekening Permendagri:
// 1=akun, 2=kelompok, 3=jenis, 4=obyek, 5=rincian, 6=sub rincian obyek.
// scope 'global' = konsolidasi, 'opd:<id>' = realisasi milik OPD tersebut.
// periode = kumulatif s.d. bulan ke-N (1..12) sesuai LRA yang diimpor
// (Peraturan Menteri Dalam Negeri: LRA disampaikan bulanan, triwulanan, semesteran).
model RealisasiAkun {
  id        Int    @id @default(autoincrement())
  code      String
  name      String
  group     String
  level     Int    @default(3)
  scope     String @default("global")
  opdId     Int?
  opd       Opd?   @relation(fields: [opdId], references: [id], onDelete: Cascade)
  periode   Int    @default(12)
  anggaran  Float
  realisasi Float

  @@unique([code, scope, periode])
  @@index([scope, periode])
  @@map("realisasi_akun")
}

// Ringkasan realisasi per SKPD per periode (kumulatif s.d. bulan ke-N)
model RealisasiSkpdPeriode {
  id                  Int    @id @default(autoincrement())
  name                String
  periode             Int
  pendapatanAnggaran  Float  @map("pendapatan_anggaran")
  pendapatanRealisasi Float  @map("pendapatan_realisasi")
  belanjaAnggaran     Float  @map("belanja_anggaran")
  belanjaRealisasi    Float  @map("belanja_realisasi")
  pembiayaanAnggaran  Float  @map("pembiayaan_anggaran")
  pembiayaanRealisasi Float  @map("pembiayaan_realisasi")

  @@unique([name, periode])
  @@map("realisasi_skpd_periode")
}

// Realisasi anggaran per SKPD (tahun berjalan)
model RealisasiSkpd {
  id                  Int    @id @default(autoincrement())
  name                String @unique
  pendapatanAnggaran  Float  @map("pendapatan_anggaran")
  pendapatanRealisasi Float  @map("pendapatan_realisasi")
  belanjaAnggaran     Float  @map("belanja_anggaran")
  belanjaRealisasi    Float  @map("belanja_realisasi")
  pembiayaanAnggaran  Float  @map("pembiayaan_anggaran")
  pembiayaanRealisasi Float  @map("pembiayaan_realisasi")

  @@map("realisasi_skpd")
}

// Dokumen transparansi anggaran
model TransparansiDoc {
  id    Int    @id @default(autoincrement())
  type  String
  title String
  url   String

  @@unique([type, title])
  @@map("transparansi_doc")
}

// Penghitung pengunjung bulanan
model VisitorCounter {
  id    Int    @id @default(autoincrement())
  month String @unique
  count Int    @default(0)

  @@map("visitor_counter")
}

// Master Data OPD/SKPD — saat dibuat otomatis menghasilkan akun login OPD
model Opd {
  id            Int             @id @default(autoincrement())
  code          String          @unique
  name          String          @unique
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  user          AdminUser?
  realisasiAkun RealisasiAkun[]
  importLogs    ImportLog[]

  @@map("opd")
}

// Akun admin dashboard / akun login OPD
model AdminUser {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String         @map("password_hash")
  role         String         @default("admin") // admin | opd
  opdId        Int?           @unique @map("opd_id")
  opd          Opd?           @relation(fields: [opdId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]

  @@map("admin_user")
}

// Sesi login admin (cookie httpOnly menyimpan id sesi)
model AdminSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now())

  @@map("admin_session")
}

// Riwayat import LRA dari PDF (per OPD atau konsolidasi)
model ImportLog {
  id          Int      @id @default(autoincrement())
  filename    String
  pages       Int      @default(0)
  records     Int      @default(0)
  status      String   @default("parsed") // parsed | confirmed | failed
  message     String?
  opdId       Int?
  opd         Opd?     @relation(fields: [opdId], references: [id], onDelete: SetNull)
  periode     Int      @default(12) // kumulatif s.d. bulan ke-N
  createdAt   DateTime @default(now())

  @@map("import_log")
}

// Pengaturan aplikasi (key-value): nama, judul, logo, favicon, dll.
model AppSetting {
  key   String @id
  value String

  @@map("app_setting")
}
